# =============================================================
#  HackQubit CRM — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to version control
# =============================================================

# ─────────────────────────────────────────────
#  GENERAL
# ─────────────────────────────────────────────
SERVER_URL=http://localhost:3000
FRONT_DOMAIN=localhost

# ─────────────────────────────────────────────
#  TWENTY CRM
# ─────────────────────────────────────────────
TWENTY_VERSION=latest

# Database
TWENTY_DB_USER=twenty
TWENTY_DB_PASSWORD=change_me_strong_password
TWENTY_DB_NAME=twenty

# App Secret — generate with: openssl rand -hex 32
TWENTY_APP_SECRET=change_me_to_a_random_64_char_hex_string_here

# ─────────────────────────────────────────────
#  CHATWOOT
# ─────────────────────────────────────────────
CHATWOOT_FRONTEND_URL=http://localhost:3001

# Database
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=change_me_strong_password
CHATWOOT_DB_NAME=chatwoot

# Secret Key — generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY=change_this_to_64_char_secret_string

# ─────────────────────────────────────────────
#  MINIO (Object Storage)
# ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_minio_password

# ─────────────────────────────────────────────
#  EMAIL (SMTP)
#  For local testing: uses MailHog (no config needed)
#  For production: fill with real SMTP credentials
# ─────────────────────────────────────────────
EMAIL_FROM_ADDRESS=noreply@hackqubit.local
EMAIL_FROM_NAME=HackQubit CRM
EMAIL_SYSTEM_ADDRESS=system@hackqubit.local
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=mailhog
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# For production Gmail SMTP:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your@gmail.com
# EMAIL_SMTP_PASS=your_app_password

# ─────────────────────────────────────────────
#  TWILIO — Voice Calling & SMS
#  Sign up at: https://www.twilio.com
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─────────────────────────────────────────────
#  WHATSAPP BUSINESS CLOUD API (Meta)
#  Setup: https://developers.facebook.com/docs/whatsapp
# ─────────────────────────────────────────────
WHATSAPP_APP_ID=your_meta_app_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# ─────────────────────────────────────────────
#  N8N WORKFLOW AUTOMATION
# ─────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_password

# ─────────────────────────────────────────────
#  ASTERISK — SIP/VoIP
# ─────────────────────────────────────────────
ASTERISK_SIP_SECRET=change_me_sip_password

# ─────────────────────────────────────────────
#  SUPER ADMIN CREDENTIALS (for demo)
# ─────────────────────────────────────────────
ADMIN_EMAIL=superadmin@hackqubit.local
ADMIN_PASSWORD=Admin@HackQubit2026!
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
