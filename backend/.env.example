# ==========================================
# HackQubit CRM - Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=hackqubit_super_secret_jwt_key_2024_change_in_prod
JWT_EXPIRES_IN=7d

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hackqubit_crm
DB_USER=crm_user
DB_PASSWORD=crm_password_2024

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO Object Storage (for call recordings, attachments)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_RECORDINGS=call-recordings
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_USE_SSL=false

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=hackqubit_verify_token_2024
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=HackQubit CRM <your_email@gmail.com>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# WebRTC / SIP
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:your_turn_server:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpassword

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
