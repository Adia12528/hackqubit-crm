# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env to git.

# ---------- Database (MariaDB) ----------
DB_NAME=espocrm
DB_USER=espocrm
DB_PASSWORD=change_this_db_password
DB_ROOT_PASSWORD=change_this_root_password

# ---------- EspoCRM ----------
# First admin account created on initial install.
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change_this_admin_password
# Public URL the app will be reached at (change for a real server/domain).
ESPOCRM_SITE_URL=http://localhost:8080
ESPOCRM_PORT=8080
ESPOCRM_WEBSOCKET_URL=ws://localhost:8081
ESPOCRM_WEBSOCKET_PORT=8081

# ---------- MinIO (S3-compatible object storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_BUCKET=espocrm-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Omnichannel integrations (optional — fill in when ready) ----------
# Outbound/inbound email (also configurable later from EspoCRM's admin UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# WhatsApp Cloud API (Meta) — see docs/OMNICHANNEL-INTEGRATION.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# SMS gateway (example: Twilio — swap for MSG91/Plivo/etc. as needed)
SMS_GATEWAY_ACCOUNT_SID=
SMS_GATEWAY_AUTH_TOKEN=
SMS_GATEWAY_FROM_NUMBER=

# Voice/telephony (example: Twilio Voice — see integration doc for Exotel/Asterisk alternatives)
VOICE_GATEWAY_ACCOUNT_SID=
VOICE_GATEWAY_AUTH_TOKEN=
VOICE_GATEWAY_FROM_NUMBER=

# EspoCRM API key used by the integration bridge services to push
# messages/calls into contact timelines. Generate from EspoCRM Admin >
# API Users after first login.
ESPOCRM_API_KEY=
